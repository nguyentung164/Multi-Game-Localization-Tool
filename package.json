{
  "name": "localization-tool",
  "private": true,
  "version": "1.2.0",
  "description": "Công cụ desktop Việt hóa nhiều game — Civilization VII, Tam Quốc và lõi Gemini dùng chung.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run test && npm run build",
    "build:engine": "powershell -ExecutionPolicy Bypass -File ./scripts/build_python.ps1",
    "build:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build_all.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
